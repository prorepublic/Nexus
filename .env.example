# Nexus local environment. Copy to .env and fill in values.
# Never commit .env. Names only in this file — no real values.

# --- Database (Docker Compose defaults shown in docker-compose.yml) ---
NEXUS_DB_USER=
NEXUS_DB_PASSWORD=
NEXUS_DB_NAME=
NEXUS_DB_PORT=
# Full override, e.g. postgresql+psycopg://user:pass@127.0.0.1:5442/nexus
NEXUS_DATABASE_URL=

# --- Control plane ---
NEXUS_API_HOST=
NEXUS_API_PORT=
NEXUS_LOG_LEVEL=

# --- Web dashboard ---
NEXT_PUBLIC_NEXUS_API_URL=

# --- Notion integration (optional; set up via `nexus notion bootstrap`) ---
# Internal integration token from https://www.notion.so/my-integrations
NEXUS_NOTION_TOKEN=
# Page ID or URL of the parent page shared with the integration
NEXUS_NOTION_PARENT_PAGE=

# --- GitHub (optional; gh CLI auth is used by default) ---
NEXUS_GITHUB_REPO=
